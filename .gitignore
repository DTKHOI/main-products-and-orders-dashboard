# Byte-compiled / optimized / DLL files (File biên dịch tạm của Python)
__pycache__/
*.py[cod]
*$py.class

# C environments & distributions
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment (Môi trường ảo nếu nhóm có dùng venv)
venv/
env/
ENV/
env.bak/
venv.bak/

# Cơ sở dữ liệu SQLite (Không nên push file DB cục bộ lên Git để tránh conflict dữ liệu)
*.sqlite
*.sqlite3
*.db
instance/

# Biến môi trường & cấu hình bí mật
.env
.env.local

# IDE & Editor files (Cấu hình riêng của máy cá nhân)
.vscode/
.idea/
*.swp
*.swo
*.docx

# Hệ điều hành rác
.DS_Store
Thumbs.db
